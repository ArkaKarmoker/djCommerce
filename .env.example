# ==============================================================================
# djCommerce - Environment Variables Template (.env.example)
# Duplicate this file as '.env' and populate with your own credentials.
# NEVER commit your production '.env' file to version control.
# ==============================================================================

# Django Core Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Stripe Payment Gateway Credentials (Get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
